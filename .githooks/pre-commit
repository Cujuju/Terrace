#!/usr/bin/env bash
# Comment budget on staged sources. Checks the working tree, not the index:
# agents share this checkout, and the file an agent is about to commit is the
# one on disk. Set TERRACE_SKIP_COMMENT_BUDGET=1 to bypass.
set -euo pipefail

if [ "${TERRACE_SKIP_COMMENT_BUDGET:-0}" = "1" ]; then
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx')

if [ ${#staged[@]} -eq 0 ]; then
  exit 0
fi

status=0
for path in "${staged[@]}"; do
  [ -f "$root/$path" ] || continue
  (cd "$root" && node tools/eslint-plugin-terrace/bin/check-file.ts "$path") || status=1
done

if [ $status -ne 0 ]; then
  echo "pre-commit: comment budget. Re-run with TERRACE_SKIP_COMMENT_BUDGET=1 only if you mean it." >&2
fi
exit $status
