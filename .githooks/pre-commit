#!/usr/bin/env bash
# Comment budget on staged sources: whoever touches a file brings the whole file
# to the cap. Checks the working tree, not the index, and invokes the checker
# through `node` — pnpm writes a POSIX symlink in node_modules/.bin on Linux and
# a .CMD on Windows, and neither is visible from the other side.
#
# SKIP_COMMENT_BUDGET=1 bypasses. It also bypasses when a peer's staged files
# would fail: this hook sees the whole index, not the paths being committed.
set -euo pipefail

if [ "${SKIP_COMMENT_BUDGET:-0}" = "1" ]; then
  exit 0
fi

root="$(git rev-parse --show-toplevel)"
checker="$root/node_modules/eslint-plugin-comment-budget/dist/bin/check-file.js"

if [ ! -f "$checker" ]; then
  exit 0
fi

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx')

if [ ${#staged[@]} -eq 0 ]; then
  exit 0
fi

status=0
for path in "${staged[@]}"; do
  if [ -f "$root/$path" ]; then
    if ! (cd "$root" && node "$checker" "$path"); then
      status=1
    fi
  fi
done

if [ $status -ne 0 ]; then
  echo "pre-commit: comment budget. SKIP_COMMENT_BUDGET=1 to bypass." >&2
fi

exit $status
