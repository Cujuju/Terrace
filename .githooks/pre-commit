#!/usr/bin/env bash
# Comment budget on staged sources: whoever touches a file brings the whole file
# to the cap. Checks the working tree, not the index — agents share this
# checkout. Set TERRACE_SKIP_COMMENT_BUDGET=1 to bypass.
set -euo pipefail

if [ "${TERRACE_SKIP_COMMENT_BUDGET:-0}" = "1" ]; then
  exit 0
fi

export COMMENT_BUDGET_REDIRECT="${COMMENT_BUDGET_REDIRECT:-docs/decisions/<arc>.md}"

root="$(git rev-parse --show-toplevel)"
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx')

if [ ${#staged[@]} -eq 0 ]; then
  exit 0
fi

status=0
for path in "${staged[@]}"; do
  [ -f "$root/$path" ] || continue
  (cd "$root" && node_modules/.bin/comment-budget-check "$path") || status=1
done

if [ $status -ne 0 ]; then
  echo "pre-commit: comment budget. Re-run with TERRACE_SKIP_COMMENT_BUDGET=1 only if you mean it." >&2
fi
exit $status
