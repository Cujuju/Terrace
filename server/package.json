{
  "name": "@terrace/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plugin-api": "./src/plugins/types.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "rollback": "node --env-file-if-exists=../.env scripts/rollback.ts",
    "import-world": "node --env-file-if-exists=../.env scripts/import-world.ts",
    "merge-world-history": "node scripts/merge-world-history.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.23",
    "@colyseus/ws-transport": "^0.18.4",
    "@terrace/shared": "workspace:*",
    "better-sqlite3": "^13.0.2",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
