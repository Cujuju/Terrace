{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "COMMENT_BUDGET_REDIRECT='docs/decisions/<arc>.md' node_modules/.bin/comment-budget-check",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
