{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM is needed by the CLIENT half's contract, not by anything in this
    // plugin directly: client/src/plugins/types.ts types onCanvasPress with
    // PointerEvent. Same reason client/tsconfig.json and plugins/wildlife carry it.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // tsc 7.0.2 does not auto-discover the pnpm-linked node_modules/@types of a
    // nested workspace package (it does for server/, one level up), and these
    // tests compile server sources that use node: builtins. Naming the types
    // explicitly is deterministic and costs nothing.
    "types": ["node"],
    // The server loads this plugin's TypeScript through Node 24's type
    // STRIPPING, exactly as it does shared/ (CLAUDE.md's hard rule). Syntax that
    // has to be transformed rather than erased — parameter properties, enums,
    // namespaces — therefore does not boot, and no test can see it: vitest
    // compiles the same files with a real transform. This flag turns that class
    // of bug into a compile error. (It caught one: StabilityMap shipped with a
    // `constructor(readonly worldSize: number)` that crashed plugin discovery.)
    "erasableSyntaxOnly": true
  },
  "include": ["protocol.ts", "server", "client", "test"]
}
