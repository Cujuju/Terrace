# Terrace server configuration — every value has a sane default; nothing here is
# required to boot a world, and nothing here is a secret (keep it that way).

# Cells per world edge. 512 needs a mid-size box; 128 is Populous-proven playable
# on a small VPS. No live resizing — changing this on an existing DB is undefined.
WORLD_SIZE=512

# How hard this world is meant to be, 1–100: 1 is warm and forgiving, 100 is
# punishing. Core stores the rating and attaches NO mechanics to it — plugins
# read it and decide what it means for them, so one dial moves every installed
# plugin together. Today the mana plugin is the only reader: it sets the default
# regen rate from this (200/s at 1, ~110.9/s at 50, 20/s at 100). Values outside
# 1–100 are clamped to the nearest end with a warning; text that is not a whole
# number is refused at boot.
WORLD_DIFFICULTY=50

# Colyseus's conventional default port.
PORT=2567

# SQLite world database path (better-sqlite3). Relative paths resolve against
# the process working directory. Under Docker Compose this is a path INSIDE the
# container; both ./data/world.db and /data/world.db are mounted from the world
# volume, so either spelling persists. Any other path would not.
DB_PATH=./data/world.db

# Fixed simulation tick rate.
TICK_HZ=10

# World snapshot cadence in seconds. Decided (docs/DESIGN.md, Q4): snapshots
# are written at this cadence only when the world changed; the last 10 are
# kept, plus one on clean shutdown.
SNAPSHOT_INTERVAL_S=60

# Directory the plugin host scans at boot for plugin server halves.
# Defaults to the repo-root plugins/ folder; Docker deployments override it.
PLUGINS_DIR=./plugins

# Directory holding a `vite build` of the client (issue #20: "one process =
# playable URL"). Defaults to client/dist next to the server package. When
# index.html is found there, the game server serves it over HTTP on its own
# PORT with SPA index-fallback — open http://<host>:<PORT> and play, no
# separate static server needed. When it is not found (the common case in
# dev, before you have run a build), the server logs that it is unbuilt and
# does nothing else: `pnpm --dir client dev` (Vite, port 5173) remains the
# dev path, exactly as before.
# CLIENT_DIST_PATH=./client/dist

# --- Plugin configuration (ignored when the plugin is not installed) ---------

# mana: how fast every player's pool refills, in mana units per second. This is
# the pace of the world's economy, and the client HUD reads it off the wire, so
# the gauge animates at whatever you set here.
#
# LEAVE IT UNSET and the rate comes from WORLD_DIFFICULTY above, interpolated
# between 200/s at difficulty 1 and 20/s at difficulty 100 — 110.9/s at the
# default 50. SET IT and your number wins outright, whatever the difficulty is:
# this setting is the more specific one, so it takes precedence.
#
# Values outside [0.1, 810] are clamped (slower is indistinguishable from a
# broken server; faster refills the whole 810 pool in under a second and is no
# longer an economy), and anything that is not a positive number is ignored with
# a warning, falling back to the difficulty-derived rate.
# MANA_REGEN_PER_S=110.9

# --- Docker Compose only (ignored when you run the server directly) ----------

# The WebSocket address the BROWSER dials. Baked into the client bundle at image
# build time, so changing it needs `docker compose up --build`. The default
# (ws://localhost:2567) only works for a browser on the Docker host itself — for
# anyone else to join, set this to an address they can reach, e.g.
# ws://your-box.example:2567, and keep the port in sync with PORT above.
# PUBLIC_WS_URL=ws://localhost:2567

# Host port that serves the browser client.
# CLIENT_PORT=8080
